{
  "name": "wegame-hybrid-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "React + Pixi.js 多端混合游戏引擎 (@wegame/hybrid-engine) 与游戏工程 (games/*) 工作区",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@wegame/star-match3 run dev",
    "test": "npm --workspace=@wegame/hybrid-engine run test",
    "test:watch": "npm --workspace=@wegame/hybrid-engine run test:watch",
    "build:engine": "npm --workspace=@wegame/hybrid-engine run build",
    "build:game": "npm --workspace=@wegame/star-match3 run build",
    "build:wx": "npm --workspace=@wegame/star-match3 run build:wx",
    "build": "npm run build:engine && npm run build:game && npm run build:wx",
    "create-game": "node packages/hybrid-engine/bin/cli.mjs create"
  }
}
