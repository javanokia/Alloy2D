{
  "name": "alloy2d",
  "version": "1.1.0",
  "description": "Alloy2D: The Alloy of React & Pixi.js for Cross-Platform Mini-Games",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@alloy2d/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "src",
    "!src/__tests__"
  ],
  "bin": {
    "alloy2d": "./bin/cli.mjs",
    "hybrid-engine": "./bin/cli.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "stats.js": "^0.17.0",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/stats.js": "^0.17.3",
    "typescript": "~5.6.2",
    "vitest": "^4.1.12"
  }
}
