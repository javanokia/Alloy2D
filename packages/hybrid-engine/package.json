{
  "name": "@wegame/hybrid-engine",
  "version": "1.0.0",
  "description": "React + Pixi.js v7 多端混合架构小游戏引擎与脚手架工具库",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "hybrid-engine": "./bin/cli.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pixi.js": "^7.4.2",
    "stats.js": "^0.17.0",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/stats.js": "^0.17.3",
    "typescript": "~5.6.2",
    "vitest": "^4.1.12"
  }
}
